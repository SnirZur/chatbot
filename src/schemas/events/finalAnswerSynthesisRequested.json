{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["conversationId", "userId", "timestamp", "eventType", "payload"],
  "additionalProperties": false,
  "properties": {
    "conversationId": { "type": "string" },
    "userId": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "eventType": { "const": "FinalAnswerSynthesisRequested" },
    "payload": {
      "type": "object",
      "required": ["userInput", "toolResults"],
      "additionalProperties": false,
      "properties": {
        "userInput": { "type": "string" },
        "toolResults": { "type": "array" }
      }
    }
  }
}
